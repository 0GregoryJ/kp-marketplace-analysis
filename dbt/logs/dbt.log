    create  table
      "analysis"."main_staging"."stg_cms_rates__dbt_tmp"
  
    
    as (
      with source as (
    select *
    from read_csv(
        '../data/raw/cms/rates/*.csv',
        union_by_name = true,
        filename = true,
        encoding = 'CP1252',
        all_varchar = true
    )
),

renamed as (

    select
        "BUSINESS YEAR"::integer as year,

        trim("STATE CODE") as state_code,
        '06' as state_fips,
